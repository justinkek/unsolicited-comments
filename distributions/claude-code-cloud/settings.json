{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/refresh.sh\""
					},
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/load-rules.sh\""
					},
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/mark-session-started.sh\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/refuse-a-comment.sh\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/note-a-new-version.sh\""
					},
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/print-session-start-if-missed.sh\""
					},
					{
						"type": "command",
						"command": "bash \"/opt/unsolicited-comments/distributions/claude-code-cloud/hooks/replay-notes.sh\""
					}
				]
			}
		]
	}
}
